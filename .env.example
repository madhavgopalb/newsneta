GEMINI_API_KEY=replace-with-gemini-key
GNEWS_API_KEY=replace-with-licensed-news-api-key
# Exact, comma-separated publisher names contractually authorized for full-text syndication.
NEWS_LICENSED_FULLTEXT_SOURCES=

# News ingestion and admin-only production health
NEWS_INGEST_CATEGORIES=latest,ap,telangana,politics,national,international,cinema,sports,cricket,technology,business,education,jobs,viral
ADMIN_HEALTH_TOKEN=replace-with-a-long-random-secret
NEWS_INGEST_CONCURRENCY=2

# Unified newsroom CMS authentication (configure scoped values in Netlify)
CMS_SESSION_SECRET=replace-with-at-least-32-random-bytes
CMS_ADMIN_EMAIL=admin@newsneta.in
CMS_ADMIN_PASSWORD=replace-with-strong-admin-password
CMS_REPORTER_EMAIL=reporter@newsneta.in
CMS_REPORTER_PASSWORD=replace-with-strong-reporter-password
CMS_REVIEWER_EMAIL=reviewer@newsneta.in
CMS_REVIEWER_PASSWORD=replace-with-strong-reviewer-password
